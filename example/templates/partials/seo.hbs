<title>{{> page-title}}</title>
{{#if (or summary home)}}<meta name="description" content="{{> page-description}}">{{/if}}
{{#if page.noindex}}
<meta name="robots" content="noindex, nofollow">
{{else}}
<link rel="canonical" href="{{absoluteUrl page.url}}">
<meta property="og:title" content="{{> page-title}}">
<meta property="og:type" content="{{#if entry.data.date}}article{{else}}website{{/if}}">
<meta property="og:url" content="{{absoluteUrl page.url}}">
<meta property="og:site_name" content="{{site.title}}">
<meta property="og:locale" content="fr_FR">
{{#if (or summary home)}}<meta property="og:description" content="{{> page-description}}">{{/if}}
{{#if cover}}<meta property="og:image" content="{{absoluteUrl cover}}">{{/if}}
<meta name="twitter:card" content="{{#if cover}}summary_large_image{{else}}summary{{/if}}">
<meta name="twitter:title" content="{{> page-title}}">
{{#if (or summary home)}}<meta name="twitter:description" content="{{> page-description}}">{{/if}}
{{#if cover}}<meta name="twitter:image" content="{{absoluteUrl cover}}">{{/if}}
{{#if entry.data.date}}<script type="application/ld+json">{{{postJsonLd entry}}}</script>{{/if}}
{{#if home}}<script type="application/ld+json">{{{websiteJsonLd}}}</script>{{/if}}
{{/if}}
