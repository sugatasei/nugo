<article>
    {{#if data.cover}}{{> picture src=data.cover alt="" sizes="(min-width: 1200px) 1130px, 100vw"}}{{/if}}

    <header>
        <h2><a href="{{url}}">{{data.title}}</a></h2>
        <p><time datetime="{{data.date}}">{{formatDate data.date}}</time></p>
    </header>

    {{#if data.summary}}<p>{{data.summary}}</p>{{/if}}

    {{> tags data}}

    <footer>
        <a href="{{url}}">Lire l’article</a>
    </footer>
</article>
