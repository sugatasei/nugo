<main class="container">
    <article>
        {{#if cover}}{{> picture src=cover alt="" sizes="(min-width: 1200px) 1130px, 100vw" eager=true}}{{/if}}

        <header>
            <h1>{{title}}</h1>
            <p>Par {{site.author}} — <time datetime="{{date}}">{{formatDate date}}</time></p>
            <p><a href="{{monthUrl date}}">Archives — {{formatMonth date}}</a></p>
        </header>

        {{> tags}}

        {{{entry.html}}}
    </article>
</main>
